---
// Ícones das redes sociais da empresa. Só aparece rede com link em conteudo/empresa.json.
import { empresa } from '../lib/empresa';

interface Props {
	class?: string;
}
const { class: classe = '' } = Astro.props;

const r = empresa.redes;
const redes = [
	{ nome: 'Instagram', href: r.instagram },
	{ nome: 'Facebook', href: r.facebook },
	{ nome: 'YouTube', href: r.youtube },
	{ nome: 'LinkedIn', href: r.linkedin },
	{ nome: 'Pinterest', href: r.pinterest },
].filter((x) => x.href);
---

<ul class:list={['redes', classe]} aria-label="Redes sociais">
	{redes.map((x) => (
		<li>
			<a
				href={x.href}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`${x.nome} (abre em nova aba)`}
				title={x.nome}
			>
				<svg
					viewBox="0 0 24 24"
					width="18"
					height="18"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					{x.nome === 'Instagram' && (
						<>
							<rect x="3" y="3" width="18" height="18" rx="5" />
							<circle cx="12" cy="12" r="4" />
							<circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
						</>
					)}
					{x.nome === 'Facebook' && (
						<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
					)}
					{x.nome === 'YouTube' && (
						<>
							<path d="M22.5 6.4a2.8 2.8 0 0 0-1.9-2C18.9 4 12 4 12 4s-6.9 0-8.6.4a2.8 2.8 0 0 0-1.9 2A29 29 0 0 0 1 11.8a29 29 0 0 0 .5 5.3 2.8 2.8 0 0 0 1.9 2c1.7.4 8.6.4 8.6.4s6.9 0 8.6-.4a2.8 2.8 0 0 0 1.9-2 29 29 0 0 0 .5-5.3 29 29 0 0 0-.5-5.4z" />
							<path d="M9.75 15 15.5 11.75 9.75 8.5z" />
						</>
					)}
					{x.nome === 'LinkedIn' && (
						<>
							<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
							<rect x="2" y="9" width="4" height="12" />
							<circle cx="4" cy="4" r="2" />
						</>
					)}
					{x.nome === 'Pinterest' && (
						<>
							<circle cx="12" cy="12" r="10" />
							<path d="M11 21l2-9" />
							<path d="M9.2 13.5A3.5 3.5 0 1 1 15 11" />
						</>
					)}
				</svg>
			</a>
		</li>
	))}
</ul>
