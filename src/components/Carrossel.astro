---
import { whatsappLink, mensagemModelo } from '../lib/empresa';
interface Props {
	fotos: { src: string; nome: string }[];
	verTodas?: string;
	rotulo?: string;
}
const { fotos, verTodas, rotulo } = Astro.props;
const total = fotos.length;
---

<div
	class="carrossel"
	data-carrossel
	role="region"
	aria-roledescription="carrossel"
	aria-labelledby={rotulo}
	aria-label={rotulo ? undefined : 'Fotos de escadas instaladas'}
>
	<div class="palco">
		<ul
			class="pista"
			data-pista
			tabindex="0"
			aria-label="Fotos, use as setas do teclado para navegar"
		>
			{fotos.map((f, i) => (
				<li
					class="slide"
					aria-label={`Foto ${i + 1} de ${total}`}
					data-wa={whatsappLink(mensagemModelo(f.nome))}
				>
					<img class="fundo" src={f.src} alt="" aria-hidden="true" loading="lazy" />
					<img
						class="foto"
						src={f.src}
						alt={`Escada ${f.nome} instalada`}
						loading={i === 0 ? 'eager' : 'lazy'}
						decoding="async"
					/>
				</li>
			))}
		</ul>
		<button type="button" class="seta ant" data-ant aria-label="Foto anterior">
			‹
		</button>
		<button type="button" class="seta prox" data-prox aria-label="Próxima foto">
			›
		</button>
	</div>
	<div class="barra">
		<p class="legenda" data-legenda aria-live="polite"></p>
		<p class="contador">
			<span data-pos>1</span> / {total}
			{verTodas && (
				<a class="ver-todas link" href={verTodas}>
					Ver todas
				</a>
			)}
		</p>
	</div>
</div>

<style>
	.palco {
		position: relative;
	}
	.pista:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: -3px;
	}
	.pista {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.pista {
		cursor: grab;
		user-select: none;
		-webkit-user-select: none;
	}
	.pista.arrastando {
		cursor: grabbing;
		scroll-snap-type: none;
		scroll-behavior: auto;
	}
	.pista.sem-snap {
		scroll-snap-type: none;
		scroll-behavior: auto;
	}
	.foto,
	.fundo {
		-webkit-user-drag: none;
		pointer-events: none;
	}
	.pista::-webkit-scrollbar {
		display: none;
	}
	@media (prefers-reduced-motion: no-preference) {
		.pista {
			scroll-behavior: smooth;
		}
	}
	.slide {
		position: relative;
		flex: 0 0 100%;
		scroll-snap-align: center;
		height: 70vh;
		min-height: 360px;
		max-height: 820px;
		overflow: hidden;
		background: color-mix(in srgb, var(--accent) 70%, #000);
		display: grid;
		place-items: center;
	}
	.foto {
		position: relative;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}
	.seta {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 48px;
		height: 48px;
		border-radius: 999px;
		border: 0;
		background: #fff;
		color: var(--accent);
		box-shadow: 0 2px 8px rgb(0 0 0 / 0.35);
		display: grid;
		place-items: center;
		padding: 0;
		cursor: pointer;
	}
	.seta:hover {
		background: #e4e8ec;
	}
	.seta:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 2px;
		box-shadow: 0 0 0 2px var(--accent);
	}
	.seta[disabled] {
		opacity: 0.35;
		cursor: default;
	}
	.ant {
		left: clamp(16px, 3vw, 48px);
	}
	.prox {
		right: clamp(16px, 3vw, 48px);
	}
	.barra {
		padding: 10px max(var(--gutter), calc((100% - var(--wrap)) / 2 + var(--gutter))) 16px;
		display: flex;
		justify-content: space-between;
		gap: 16px;
		font-size: 0.875rem;
		color: rgb(255 255 255 / 0.82);
	}
	.barra p {
		margin: 0;
	}
	.ver-todas {
		margin-left: 12px;
	}
	@media (max-width: 640px) {
		.seta {
			width: 44px;
			height: 44px;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-carrossel]').forEach((c) => {
		const pista = c.querySelector<HTMLElement>('[data-pista]')!;
		const reais = Array.from(pista.children) as HTMLElement[];
		const n = reais.length;
		const ant = c.querySelector<HTMLButtonElement>('[data-ant]')!;
		const prox = c.querySelector<HTMLButtonElement>('[data-prox]')!;
		const pos = c.querySelector<HTMLElement>('[data-pos]')!;
		const legenda = c.querySelector<HTMLElement>('[data-legenda]')!;
		const nomes = reais.map((s) =>
			s.querySelector<HTMLImageElement>('.foto')!.alt.replace(/ instalada.*/, ''),
		);
		const cta = document.querySelector<HTMLAnchorElement>('[data-cta-carrossel]');
		const waPadrao = cta?.href ?? '';

		// Scroll infinito: cópias antes e depois; ao parar numa cópia, salta para a equivalente do meio.
		const loop = n > 1;
		if (loop) {
			const copia = () =>
				reais.map((s) => {
					const k = s.cloneNode(true) as HTMLElement;
					k.setAttribute('aria-hidden', 'true');
					k.removeAttribute('aria-label');
					return k;
				});
			pista.prepend(...copia());
			pista.append(...copia());
		}
		const slides = Array.from(pista.children) as HTMLElement[];
		const base = loop ? n : 0;
		const largura = () => pista.clientWidth;
		const atual = () => Math.round(pista.scrollLeft / largura());
		const semAnimar = (fn: () => void) => {
			pista.classList.add('sem-snap');
			fn();
			requestAnimationFrame(() => pista.classList.remove('sem-snap'));
		};
		const irPara = (i: number, suave = true) => {
			const alvo = Math.max(0, Math.min(slides.length - 1, i));
			if (suave) pista.scrollTo({ left: alvo * largura() });
			else semAnimar(() => (pista.scrollLeft = alvo * largura()));
		};
		const recentrar = () => {
			if (!loop) return;
			const i = atual();
			if (i < n) irPara(i + n, false);
			else if (i >= 2 * n) irPara(i - n, false);
		};
		const real = () => (((atual() - base) % n) + n) % n;
		const atualizar = () => {
			const i = atual();
			const r = loop ? real() : i;
			pos.textContent = String(r + 1);
			legenda.textContent = nomes[r] ?? '';
			if (!loop) {
				ant.disabled = i <= 0;
				prox.disabled = i >= slides.length - 1;
			}
			slides.forEach((s, k) => s.toggleAttribute('inert', k !== i));
			if (cta) cta.href = slides[i]?.dataset.wa || waPadrao;
		};

		ant.addEventListener('click', () => irPara(atual() - 1));
		prox.addEventListener('click', () => irPara(atual() + 1));
		c.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') {
				e.preventDefault();
				irPara(atual() - 1);
			}
			if (e.key === 'ArrowRight') {
				e.preventDefault();
				irPara(atual() + 1);
			}
		});

		let timer: number | undefined;
		pista.addEventListener(
			'scroll',
			() => {
				requestAnimationFrame(atualizar);
				clearTimeout(timer);
				timer = window.setTimeout(recentrar, 140);
			},
			{ passive: true },
		);
		pista.addEventListener('scrollend', recentrar);

		// Arrastar com o mouse (toque já rola nativamente).
		let arrastando = false;
		let x0 = 0;
		let s0 = 0;
		let dx = 0;
		pista.addEventListener('dragstart', (e) => e.preventDefault());
		pista.addEventListener('pointerdown', (e) => {
			if (e.pointerType !== 'mouse' || e.button !== 0) return;
			recentrar();
			arrastando = true;
			x0 = e.clientX;
			s0 = pista.scrollLeft;
			dx = 0;
			pista.classList.add('arrastando');
			pista.setPointerCapture(e.pointerId);
		});
		pista.addEventListener('pointermove', (e) => {
			if (!arrastando) return;
			dx = e.clientX - x0;
			pista.scrollLeft = s0 - dx;
		});
		const soltar = (e: PointerEvent) => {
			if (!arrastando) return;
			arrastando = false;
			pista.releasePointerCapture(e.pointerId);
			const w = largura();
			const i0 = Math.round(s0 / w);
			const passo = Math.abs(dx) > w * 0.12 ? (dx < 0 ? 1 : -1) : 0;
			pista.classList.remove('arrastando');
			irPara(i0 + passo);
		};
		pista.addEventListener('pointerup', soltar);
		pista.addEventListener('pointercancel', soltar);

		window.addEventListener('resize', () => irPara(atual(), false));
		irPara(base, false);
		atualizar();
	});
</script>
