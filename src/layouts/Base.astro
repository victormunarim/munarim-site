---
import '../styles/global.css';
// Fontes críticas pré-carregadas: evita o texto aparecer na fonte reserva (maior) e depois encolher.
import barlow400 from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import barlow600 from '@fontsource/barlow/files/barlow-latin-600-normal.woff2?url';
import condensed700 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import { getCollection } from 'astro:content';
import {
	empresa,
	whatsappLink,
	mensagemPadrao,
	publicavel,
	faqPronta,
	anosDeMercado,
} from '../lib/empresa';
import IconeWhatsapp from '../components/IconeWhatsapp.astro';
import CtaWhatsapp from '../components/CtaWhatsapp.astro';
import Redes from '../components/Redes.astro';
import Icone from '../components/Icone.astro';

interface Props {
	titulo: string;
	descricao: string;
	imagem?: string;
	semBarraWa?: boolean;
}
const { titulo, descricao, imagem = '/share.jpg', semBarraWa = false } = Astro.props;
// Com build.format 'file' o pathname vem com .html; o endereço público não tem.
const caminho = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(caminho, Astro.site).href;
const tituloCompleto = caminho === '/' ? titulo : `${titulo} | Escadas Munarim`;

const wa = whatsappLink(mensagemPadrao);

const temModelos = publicavel(await getCollection('modelos')).length > 0;
const menu = [
	{ href: '/', rotulo: 'Início' },
	...(temModelos ? [{ href: '/escadas', rotulo: 'Nossas Escadas' }] : []),
	{ href: '/fotos', rotulo: 'Fotos' },
	...(faqPronta ? [{ href: '/perguntas-frequentes', rotulo: 'Perguntas' }] : []),
	{ href: '/sobre', rotulo: 'Nossa Empresa' },
	{ href: '/contato', rotulo: 'Entre em Contato' },
];
const atual = (href: string) =>
	href === '/' ? caminho === '/' : caminho === href || caminho.startsWith(href + '/');
const tel = empresa.contatos.telefone.valor;
const telHref = `tel:+55${tel.replace(/\D/g, '')}`;
const email = empresa.contatos.email.valor;
const end = empresa.endereco;
const wpp = empresa.contatos.whatsapp.valor;
const criador = empresa.criadoPor;
const criadorWa = criador.whatsapp
	? whatsappLink('Olá! Vi o site da Escadas Munarim e quero um site assim.', criador.whatsapp)
	: null;
const wppGeral = empresa.contatos.whatsappAtendimento.valor;

// Dados estruturados só com o que a empresa já confirmou.
const e = empresa.endereco;
const jsonLd: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	name: empresa.nomeFantasia,
	description: 'Empresa de escadas pré-moldadas de concreto sob medida em São José, SC.',
	url: Astro.site?.href,
	areaServed: empresa.regiaoAtendida.atende,
};
if (e.confirmado) {
	jsonLd.address = {
		'@type': 'PostalAddress',
		streetAddress: e.rua,
		addressLocality: e.cidade,
		addressRegion: e.uf,
		postalCode: e.cep,
		addressCountry: 'BR',
	};
}
if (empresa.contatos.telefone.confirmado) jsonLd.telephone = empresa.contatos.telefone.valor;
jsonLd.sameAs = Object.entries(empresa.redes)
	.filter(([k, v]) => k !== 'mapa' && k !== 'avaliarGoogle' && v)
	.map(([, v]) => v);
if (empresa.contatos.email.confirmado) jsonLd.email = empresa.contatos.email.valor;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{[barlow400, barlow600, condensed700].map((f) => (
			<link rel="preload" as="font" type="font/woff2" href={f} crossorigin />
		))}
		<title>{tituloCompleto}</title>
		<meta name="description" content={descricao} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta name="theme-color" content="#284360" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content="Escadas Munarim" />
		<meta property="og:title" content={tituloCompleto} />
		<meta property="og:description" content={descricao} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL(imagem, Astro.site).href} />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="min-h-screen flex flex-col">
		<a
			href="#conteudo"
			class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-surface focus:p-3"
		>
			Ir para o conteúdo
		</a>

		<div class="topbar on-brand">
			<div class="wrap flex items-center justify-between gap-4 min-h-9 text-[0.8125rem]">
				<p class="hidden sm:flex gap-x-4 lg:gap-x-5 muted whitespace-nowrap">
					<span class="hidden md:block">
						<a
							class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap hover:underline"
							href={telHref}
						>
							<Icone nome="telefone" size={14} />
							{tel}
						</a>
					</span>
					<a
						class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap hover:underline"
						href={wa}
						rel="noopener"
						title="WhatsApp vendas"
					>
						<IconeWhatsapp size={14} />
						{wpp}
					</a>
					<span class="hidden lg:block">
						<a
							class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap hover:underline"
							href={`mailto:${email}`}
						>
							<Icone nome="email" size={14} />
							{email}
						</a>
					</span>
				</p>
				<p class="topbar-wa muted whitespace-nowrap">
					<a
						class="inline-flex items-center gap-1.5 whitespace-nowrap shrink-0"
						href={wa}
						rel="noopener"
					>
						<IconeWhatsapp size={14} />
						{wpp}
					</a>
				</p>
				<Redes class="ml-auto" />
			</div>
		</div>

		<header class="on-brand sticky top-0 z-40">
			<div class="wrap flex items-center justify-between gap-4 min-h-16 py-3 relative">
				<div class="marca">
					<a href="/" aria-label="Escadas Munarim, página inicial">
						<img
							src="/img/logo.png"
							alt="Escadas Munarim"
							width="700"
							height="156"
							class="logo-header"
						/>
					</a>
					<p class="anos">
						<strong>{anosDeMercado}</strong>
						<span>anos</span>
					</p>
				</div>
				<nav aria-label="Principal" class="hidden lg:flex gap-7 text-base ml-auto">
					{menu.map((m) => (
						<a
							href={m.href}
							class="link-nav hover:underline underline-offset-4"
							aria-current={atual(m.href) ? 'page' : undefined}
						>
							{m.rotulo}
						</a>
					))}
				</nav>
				<CtaWhatsapp grande={false} class="cta-header" rotulo="Pedir orçamento" />
				<details class="menu-mobile lg:hidden ml-auto">
					<summary aria-label="Abrir menu" data-menu-toggle>
						Menu
					</summary>
					<nav aria-label="Principal (menu)">
						{menu.map((m) => (
							<a href={m.href} aria-current={atual(m.href) ? 'page' : undefined}>
								{m.rotulo}
							</a>
						))}
					</nav>
				</details>
			</div>
		</header>

		<main id="conteudo" class="flex-1">
			<slot />
		</main>

		{!semBarraWa && (
			<div class="barra-wa" data-barra-wa>
				<a href={wa} class="btn btn-lg w-full" rel="noopener">
					<IconeWhatsapp />
					<span>Pedir orçamento pelo WhatsApp</span>
				</a>
			</div>
		)}

		<footer class="rodape">
			<div class="on-brand">
				<div class="wrap py-12 grid gap-10 text-sm md:grid-cols-[1.3fr_1fr_auto] md:gap-14 md:items-start">
					<div class="grid gap-4 justify-items-start">
						<img
							src="/img/logo.png"
							alt="Escadas Munarim"
							width="700"
							height="156"
							class="logo-rodape"
							loading="lazy"
						/>
						<p class="muted max-w-[44ch]">
							Escadas pré-moldadas em concreto sob medida: caracol, reta, mista, viga
							central, viga lateral, cascata, com corrimão e guarda-corpo.
						</p>
						{faqPronta && (
							<a class="link muted" href="/perguntas-frequentes">
								Perguntas frequentes
							</a>
						)}
					</div>

					<div class="grid gap-3 content-start">
						<h2 class="rodape-titulo">Contato</h2>
						<address class="muted not-italic">
							{end.rua}, {end.bairro}
							<br />
							{end.cidade}/{end.uf}, CEP {end.cep}
							<br />
							{end.referencia}
						</address>
						<ul class="grid gap-1 muted">
							<li>
								<a
									class="inline-flex items-center gap-2 hover:underline"
									href={telHref}
								>
									<Icone nome="telefone" size={14} />
									{tel}
								</a>
							</li>
							<li>
								<a
									class="inline-flex items-center gap-2 hover:underline"
									href={whatsappLink(mensagemPadrao, wppGeral)}
									rel="noopener"
								>
									<IconeWhatsapp size={14} />
									{wppGeral} (atendimento geral)
								</a>
							</li>
							<li>
								<a
									class="inline-flex items-center gap-2 hover:underline"
									href={`mailto:${email}`}
								>
									<Icone nome="email" size={14} />
									{email}
								</a>
							</li>
						</ul>
						<p class="muted">{empresa.contatos.horario}</p>
					</div>

					<div class="grid gap-3 content-start">
						<h2 class="rodape-titulo">Redes sociais</h2>
						<Redes class="redes-alinhada" />
					</div>
				</div>
			</div>
			<div class="faixa-preta">
				<div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-4 text-[0.8125rem]">
					<p>Copyright © {new Date().getFullYear()} - Escadas Munarim</p>
					{criadorWa && (
						<p class="inline-flex items-center gap-2">
							Quer um site assim?
							<a
								class="inline-flex items-center gap-1.5 hover:underline"
								href={criadorWa}
								rel="noopener"
							>
								<IconeWhatsapp size={14} />
								{criador.whatsapp}
							</a>
						</p>
					)}
				</div>
			</div>
		</footer>
		<script>
			// Menu mobile: rótulo acompanha o estado, Esc e clique fora fecham.
			const menu = document.querySelector<HTMLDetailsElement>('.menu-mobile');
			const toggle = menu?.querySelector('summary');
			menu?.addEventListener('toggle', () => {
				toggle?.setAttribute('aria-label', menu.open ? 'Fechar menu' : 'Abrir menu');
			});
			document.addEventListener('keydown', (ev) => {
				if (ev.key === 'Escape' && menu?.open) {
					menu.open = false;
					toggle?.focus();
				}
			});
			document.addEventListener('click', (ev) => {
				if (menu?.open && !menu.contains(ev.target as Node)) menu.open = false;
			});

			// Barra fixa some enquanto outro CTA grande está na tela (evita dois botões iguais).
			const barra = document.querySelector<HTMLElement>('[data-barra-wa]');
			const ctas = document.querySelectorAll('main .btn-lg');
			if (barra && ctas.length && 'IntersectionObserver' in window) {
				const visiveis = new Set<Element>();
				const obs = new IntersectionObserver((entradas) => {
					entradas.forEach((e) =>
						e.isIntersecting ? visiveis.add(e.target) : visiveis.delete(e.target),
					);
					barra.classList.toggle('barra-wa--oculta', visiveis.size > 0);
				});
				ctas.forEach((c) => obs.observe(c));
			}
		</script>
	</body>
</html>
