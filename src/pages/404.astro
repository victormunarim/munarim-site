---
import Base from '../layouts/Base.astro';
import CtaWhatsapp from '../components/CtaWhatsapp.astro';
---

<Base titulo="Página não encontrada" descricao="Página não encontrada.">
	<section class="wrap py-16 grid gap-5 max-w-2xl">
		<h1>Página não encontrada</h1>
		<p class="text-lg text-muted">
			O endereço que você abriu não existe ou mudou de lugar. Volte ao início ou fale direto
			com a gente.
		</p>
		<div class="flex flex-wrap items-center gap-4">
			<a class="btn btn-lg" href="/">
				Voltar ao início
			</a>
			<CtaWhatsapp grande={false} rotulo="Pedir orçamento" class="btn-ghost" />
		</div>
	</section>
</Base>
