---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Pendente from '../../components/Pendente.astro';
import CtaWhatsapp from '../../components/CtaWhatsapp.astro';
import { publicavel } from '../../lib/empresa';

const modelos = publicavel(await getCollection('modelos'));
---

<Base
	titulo="Modelos de escadas de concreto pré-moldadas"
	descricao="Escadas caracol, reta, viga central, viga lateral e outros modelos pré-moldados de concreto sob medida."
>
	<section class="wrap py-16">
		<h1>Modelos</h1>
		<div class="grid gap-4 mt-8 sm:grid-cols-2 lg:grid-cols-4">
			{modelos.map((m) => (
				<a class="card p-5 grid gap-2" href={`/escadas/${m.data.slug}`}>
					{m.data.foto_principal && (
						<img
							class="w-full aspect-[4/3] object-cover rounded"
							src={m.data.foto_principal}
							alt={`Escada ${m.data.nome}`}
							loading="lazy"
						/>
					)}
					<h2 class="text-2xl">{m.data.nome}</h2>
					{m.data.resumo ? (
						<p class="text-sm text-muted">{m.data.resumo}</p>
					) : (
						<Pendente texto="resumo" />
					)}
				</a>
			))}
		</div>
		{modelos.length === 0 && (
			<div class="grid gap-4 mt-8 max-w-xl">
				<p class="text-lg">
					Estamos organizando o catálogo de modelos. Conte o que você precisa e indicamos
					a escada certa para o seu espaço.
				</p>
				<div>
					<CtaWhatsapp />
				</div>
			</div>
		)}
	</section>
</Base>
