---
import Base from '../layouts/Base.astro';
import CtaWhatsapp from '../components/CtaWhatsapp.astro';
import { empresa } from '../lib/empresa';

const e = empresa.endereco;
const valores = [
	'Comprometimento',
	'Credibilidade',
	'Eficiência e eficácia',
	'Transparência',
	'Melhoria contínua',
	'Respeito aos prazos',
	'Adaptação ao mercado',
];
const { instagram, youtube } = empresa.redes;
---

<Base
	titulo="Nossa Empresa"
	descricao="Fabricante de escadas pré-moldadas de concreto sob medida em São José, SC."
>
	<section class="wrap secao grid gap-6 max-w-3xl">
		<h1>Nossa Empresa</h1>
		<p class="text-lg">
			Escadas Munarim, comprometimento com o cliente! Fabricamos escadas pré-moldadas de
			concreto com projetos personalizados para residências e comércios, com produção própria
			em São José, SC.
		</p>
		<p>
			Nossa equipe é qualificada, e também oferecemos revestimentos complementares. Cada
			escada parte das medidas do seu espaço: você nos envia, e indicamos o modelo certo.
		</p>

		<div class="grid gap-6 sm:grid-cols-2 mt-4">
			<div class="etapa">
				<h2 class="text-3xl">Missão</h2>
				<p class="mt-2">
					Fabricar produtos de qualidade que superem as expectativas dos clientes.
				</p>
			</div>
			<div class="etapa">
				<h2 class="text-3xl">Visão</h2>
				<p class="mt-2">
					Ser reconhecida como referência no setor, com seriedade, alto padrão e bom
					atendimento.
				</p>
			</div>
		</div>

		<div class="grid gap-3 mt-4">
			<h2>Valores</h2>
			<ul class="grid gap-1 list-disc pl-5 sm:grid-cols-2">
				{valores.map((v) => (
					<li>{v}</li>
				))}
			</ul>
		</div>

		<div class="grid gap-3 mt-4">
			<h2>Quem atendemos</h2>
			<p>
				Construtoras da Grande Florianópolis, engenheiros e arquitetos, além de pessoas
				físicas e jurídicas.
			</p>
		</div>

		<div class="grid gap-3 mt-4">
			<h2>O que fazemos</h2>
			<p>
				Escadas de concreto polido sob medida: caracol, reta, leke, mista, premium, viga
				central, viga lateral e cascata in loco. Também trabalhamos com corrimão inox, ferro
				galvanizado, guarda-corpo e sacada.
			</p>
		</div>

		<div class="grid gap-3 mt-4">
			<h2>Venha conhecer</h2>
			<p>
				{e.rua}, {e.bairro}
				<br />
				{e.cidade}/{e.uf}, CEP {e.cep}
				<br />
				{empresa.contatos.horario}
			</p>
			<p>
				Veja nosso trabalho no{' '}
				<a class="link" href={instagram} rel="noopener">
					Instagram
				</a>{' '}
				e no{' '}
				<a class="link" href={youtube} rel="noopener">
					YouTube
				</a>
				.
			</p>
		</div>

		<div class="flex flex-wrap items-center gap-4 mt-2">
			<CtaWhatsapp />
			<a class="link" href="/contato">
				Outras formas de contato
			</a>
		</div>
	</section>
</Base>
